        <collision name="collision"><geometry><box><size>0.05 0.05 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.05 0.05 0.05</size></box></geometry><material><ambient>0.9 0.75 0.02 1</ambient><diffuse>1.0 0.85 0.02 1</diffuse></material></visual>
