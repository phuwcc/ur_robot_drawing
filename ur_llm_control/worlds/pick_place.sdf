      <link name="link"><visual name="visual"><geometry><cylinder><radius>0.045</radius><length>0.002</length></cylinder></geometry><material><ambient>0.15 0.8 0.2 1</ambient><diffuse>0.15 0.8 0.2 1</diffuse></material></visual></link>
